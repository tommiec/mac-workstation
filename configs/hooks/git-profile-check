#!/bin/sh
# Shared git identity guard, used by the pre-commit and pre-push hooks.
#
# Identity is routed per forge by the includeIf rules in ~/.gitconfig. This
# guard verifies the *outcome* of that routing instead of re-implementing it,
# so adding a forge needs no change here. Policy: ~/Repositories/GIT.md
#
# Usage: git-profile-check commit
#        git-profile-check push     (pre-push stdin format on stdin)

mode="${1:-commit}"
identity_dir="$HOME/.config/git"

# Origin of a config value, without the "file:" prefix and the value itself.
config_origin() {
    git config --show-origin --get "$1" 2>/dev/null \
        | sed -e 's/^file://' -e 's/	.*$//'
}

# True when a sha consists only of zeroes (git's "no such ref" placeholder).
is_zero_sha() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

# ── Per-repository overrides ────────────────────────────
# Checked explicitly rather than inferred from the resolved origin: this names
# the offending keys, and worktree config lives in a separate file that
# --local does not read.

local_ident="$(git config --local --get-regexp '^user\.(name|email)$' 2>/dev/null)"

# Only a repo with extensions.worktreeConfig has a separate worktree config;
# without it --worktree is an alias for --local and would report the same
# override twice.
worktree_ident=""
if [ "$(git config --get extensions.worktreeConfig 2>/dev/null)" = "true" ]; then
    worktree_ident="$(git config --worktree --get-regexp '^user\.(name|email)$' 2>/dev/null)"
fi

if [ -n "$local_ident" ] || [ -n "$worktree_ident" ]; then
    echo "Blocked: this repository sets its own git identity." >&2
    echo "" >&2
    [ -n "$local_ident" ] && echo "$local_ident" | sed 's/^/    .git\/config: /' >&2
    [ -n "$worktree_ident" ] && echo "$worktree_ident" | sed 's/^/    worktree: /' >&2
    cat >&2 <<'EOF'

Identity comes from ~/.config/git/identity-* through the includeIf rules in
~/.gitconfig, never from a repository. Remove the override:

    git config --local --unset-all user.name
    git config --local --unset-all user.email

See ~/Repositories/GIT.md.
EOF
    exit 1
fi

# ── Resolved identity ───────────────────────────────────

email="$(git config --get user.email 2>/dev/null)"
name="$(git config --get user.name 2>/dev/null)"
email_from="$(config_origin user.email)"
name_from="$(config_origin user.name)"

if [ -z "$email" ] || [ -z "$name" ]; then
    cat >&2 <<'EOF'
Blocked: no git identity resolved for this repository.

Its 'origin' matches none of the includeIf rules in ~/.gitconfig, so no
identity file applies. Add or correct the remote, or add the forge as
described in ~/Repositories/GIT.md. Never set an identity globally.
EOF
    exit 1
fi

case "$email_from" in
    "$identity_dir"/identity-*) ;;
    *)
        cat >&2 <<EOF
Blocked: git identity does not come from a managed identity file.

    user.email <- ${email_from:-<unknown>}

Expected one of $identity_dir/identity-*. Run 'mm install' to reinstall the
managed git profile. See ~/Repositories/GIT.md.
EOF
        exit 1
        ;;
esac

if [ "$name_from" != "$email_from" ]; then
    cat >&2 <<EOF
Blocked: name and email come from different files.

    user.name  <- ${name_from:-<unknown>}
    user.email <- $email_from

Both must come from the same identity file. Run 'mm install'.
EOF
    exit 1
fi

[ "$mode" = "push" ] || exit 0

# ── Outgoing commits (pre-push only) ────────────────────
# Anchored on the committer: commits *you* created must carry the expected
# author. A commit with a different committer is somebody else's work that you
# merged — a Renovate PR, a co-author — and is left alone, because blocking it
# would make merging such a branch impossible. Separately, git's hostname
# fallback address is rejected in either field: that is the signature of a
# machine whose identity configuration went missing.

bad=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    is_zero_sha "$local_sha" && continue

    if is_zero_sha "$remote_sha"; then
        set -- "$local_sha" --not --remotes
    else
        set -- "$remote_sha..$local_sha"
    fi

    commits="$(git log --format='%h %ae %ce' "$@" 2>/dev/null)"
    [ -n "$commits" ] || continue

    while read -r sha author_email committer_email; do
        [ -n "$sha" ] || continue
        case "$author_email$committer_email" in
            *'.(none)'*)
                bad="$bad
    $sha  hostname fallback address: $author_email / $committer_email"
                continue
                ;;
        esac
        if [ "$committer_email" = "$email" ] && [ "$author_email" != "$email" ]; then
            bad="$bad
    $sha  committed by you but authored as: $author_email"
        fi
    done <<EOF
$commits
EOF
done

if [ -n "$bad" ]; then
    echo "Blocked: outgoing commits carry an unexpected author." >&2
    echo "$bad" >&2
    cat >&2 <<EOF

Expected: $name <$email>

Rewrite the affected commits before pushing, for example:

    git rebase -i --exec 'git commit --amend --no-edit --reset-author' <base>

See ~/Repositories/GIT.md.
EOF
    exit 1
fi

exit 0
